{
  "name": "files-converter-api",
  "version": "1.0.0",
  "description": "A production-ready NestJS backend API for file conversion. Supports image format conversion with AI background removal, 3D model conversion and optimization, and general file format conversion.",
  "author": "mohamed boukari",
  "private": false,
  "license": "MIT",
  "keywords": [
    "nestjs",
    "file-conversion",
    "image-processing",
    "3d-models",
    "gltf",
    "glb",
    "sharp",
    "background-removal",
    "fastify",
    "typescript",
    "api",
    "swagger",
    "openapi",
    "rate-limiting",
    "production-ready"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedboukari/files-converter-api.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedboukari/files-converter-api/issues"
  },
  "homepage": "https://github.com/mohamedboukari/files-converter-api#readme",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@clerk/backend": "^2.23.2",
    "@clerk/fastify": "^2.6.4",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@types/archiver": "^7.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsbarcode": "^3.11.4",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "canvas": "^3.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "epub-gen": "^0.1.0",
    "epub-parser": "^0.2.5",
    "exceljs": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "gif-encoder": "^0.7.2",
    "heic-convert": "^2.1.0",
    "highlight.js": "^11.11.1",
    "html-pdf-node": "^1.0.8",
    "jsbarcode": "^3.12.1",
    "jsqr": "^1.4.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "potrace": "^2.1.8",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "tar-stream": "^3.1.7",
    "tesseract.js": "^6.0.1",
    "three": "^0.181.2",
    "turndown": "^7.2.2",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/html-pdf-node": "^1.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fastify": "^5.6.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
